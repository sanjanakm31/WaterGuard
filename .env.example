# This file is directly runnable with lab-only demonstration keys. Copy it
# to .env if needed, then generate new keys before sharing or multi-VM use.
# NEVER commit a real .env file; .gitignore already excludes it.
#
# Generate the three key values below with:
#   python3 tools/generate_secrets.py
#
# In a multi-VM deployment, WG_COMMAND_HMAC_KEY belongs on the legitimate
# HMI and gateway. Give it to the lab attacker VM only when demonstrating a
# compromised authenticated client. WG_EVIDENCE_HMAC_KEY and
# WG_EVIDENCE_AES_KEY belong only on the gateway/dashboard/evidence-tool VM.
# Device B requires none of these keys. WG_AUTHORIZED_SOURCES must list the
# real source IP of the legitimate HMI VM.

WG_COMMAND_HMAC_KEY=REPLACE_WITH_GENERATED_KEY
WG_EVIDENCE_HMAC_KEY=REPLACE_WITH_GENERATED_KEY
WG_EVIDENCE_AES_KEY=REPLACE_WITH_GENERATED_KEY

# client_id=ip_address pairs, comma-separated. This is Device A's/the
# legitimate client's expected source IP as seen BY THE GATEWAY.
WG_AUTHORIZED_SOURCES=hmi-01=127.0.0.1

# Endpoints -- override the IPs for your multi-VM layout, e.g.:
#   WG_CONTROLLER_HOST=192.168.56.12   (Device B's VM IP, set on the Gateway's VM)
#   WG_GATEWAY_HOST=0.0.0.0            (Gateway always binds all interfaces;
#                                        restrict who can reach it via your
#                                        VM firewall instead)
WG_CONTROLLER_HOST=127.0.0.1
WG_CONTROLLER_MODBUS_PORT=5502
WG_GATEWAY_TRUSTED_IP=127.0.0.1
WG_GATEWAY_HOST=0.0.0.0
WG_GATEWAY_WCP_PORT=6000
WG_GATEWAY_MODBUS_PORT=1502
WG_DASHBOARD_HOST=0.0.0.0
WG_DASHBOARD_PORT=8443
WG_CAPTURE_INTERFACE=auto

WG_REPLAY_WINDOW_SECONDS=5.0
WG_NONCE_CACHE_TTL_SECONDS=120.0
