@echo off
setlocal
title WaterGuard Windows Status and Export Fix
echo Updating your existing WaterGuard project code. Keys and evidence are kept.
set "WG_REPAIR_PY=%USERPROFILE%\Downloads\WaterGuard_Updated_v2_Windows_Fixed\waterguard\.venv\Scripts\python.exe"
if exist "%WG_REPAIR_PY%" (
  "%WG_REPAIR_PY%" -c "from pathlib import Path; import sys; text=Path(sys.argv[1]).read_text(encoding='utf-8'); exec(text.split('\n# __WATERGUARD_UPDATE_PYTHON__\n',1)[1])" "%~f0"
) else (
  py -3.12 -c "from pathlib import Path; import sys; text=Path(sys.argv[1]).read_text(encoding='utf-8'); exec(text.split('\n# __WATERGUARD_UPDATE_PYTHON__\n',1)[1])" "%~f0"
)
if errorlevel 1 (
  echo The update did not finish. Read the message above.
  pause
  exit /b 1
)
pause
exit /b 0
# __WATERGUARD_UPDATE_PYTHON__
import ast
import base64
import gzip
import json
import os
from pathlib import Path
import shutil
import socket
import sys
import tempfile

PAYLOAD = ""
ALLOWED = ('run_waterguard.py', 'tools/launch_windows.py', 'tests/test_runtime_status.py', 'tests/test_waterguard_core.py', 'EXPORT_UBUNTU_CLIENT.bat', 'UPDATE_NOTES.txt', 'VERIFICATION_REPORT.md', 'START_HERE.txt', 'ui/guide.html', 'WINDOWS_FIX_README.txt')

def project(path):
    return ((path / "START_WINDOWS_OPERATIONS.bat").is_file()
            and (path / "run_waterguard.py").is_file()
            and (path / ".env").is_file())

def choose_target():
    known = Path.home() / "Downloads" / "WaterGuard_Presentation_v3 (1)" / "waterguard"
    if project(known):
        return known
    import tkinter as tk
    from tkinter import filedialog
    window = tk.Tk()
    window.withdraw()
    try:
        selected = filedialog.askdirectory(
            title="Choose your EXISTING WaterGuard waterguard folder",
            initialdir=str(Path.home() / "Downloads"), parent=window)
    finally:
        window.destroy()
    if not selected or not project(Path(selected)):
        raise RuntimeError("Choose the existing waterguard folder containing .env and START_WINDOWS_OPERATIONS.bat.")
    return Path(selected)

def require_stopped():
    for port in (6000, 1502, 5502, 8443):
        try:
            connection = socket.create_connection(("127.0.0.1", port), timeout=0.2)
        except OSError:
            continue
        connection.close()
        raise RuntimeError(f"A service is still running on port {port}. Use Stop safely, wait until Stopped, close the old launcher, then run this update again.")

def apply_update(root):
    root = Path(root)
    if not project(root):
        raise RuntimeError("The selected folder is not the existing WaterGuard project.")
    mapping = json.loads(gzip.decompress(base64.b64decode(PAYLOAD)))
    if set(mapping) != set(ALLOWED):
        raise RuntimeError("The update payload is incomplete.")
    decoded = {}
    for name, encoded in mapping.items():
        path = Path(name)
        if path.is_absolute() or ".." in path.parts or path.parts[0] in ("data", ".venv", "tls") or path.name == ".env":
            raise RuntimeError("Unexpected update path.")
        contents = base64.b64decode(encoded, validate=True)
        if path.suffix == ".py":
            ast.parse(contents.decode("utf-8"), filename=name)
        decoded[name] = contents
    backup_parent = root / "data" / "code-update-backups"
    backup_parent.mkdir(parents=True, exist_ok=True)
    backup = Path(tempfile.mkdtemp(prefix="windows-status-", dir=backup_parent))
    existed = {}
    for name in decoded:
        source = root / name
        existed[name] = source.exists()
        if existed[name]:
            saved = backup / name
            saved.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, saved)
    applied = []
    try:
        for name, contents in decoded.items():
            target = root / name
            target.parent.mkdir(parents=True, exist_ok=True)
            applied.append(name)
            target.write_bytes(contents)
    except OSError:
        for name in reversed(applied):
            target = root / name
            if existed[name]:
                shutil.copy2(backup / name, target)
            else:
                target.unlink(missing_ok=True)
        raise
    return backup

def main():
    try:
        target = choose_target()
        print("Existing project:", target)
        require_stopped()
        backup = apply_update(target)
        print("UPDATE APPLIED")
        print("Your .env, database, captures, certificates, settings and Python environment were kept.")
        print("Previous code backup:", backup)
        print("Reopen START_WINDOWS_OPERATIONS.bat in the existing project folder.")
        print("Verify this installation again, then Start WaterGuard.")
        print("Use EXPORT_UBUNTU_CLIENT.bat if you want the direct ZIP exporter.")
        try:
            os.startfile(str(target))
        except OSError as exc:
            print("Open the project folder shown above:", exc)
        return 0
    except Exception as exc:
        print("UPDATE ERROR:", exc)
        print("Keep this window visible and share the error.")
        return 1

if __name__ == "__main__":
    raise SystemExit(main())
